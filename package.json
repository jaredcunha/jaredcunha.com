{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run watch:images\" \"next dev\"",
    "dev:fast": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "upload:images": "node scripts/upload-to-cloudinary.js",
    "watch:images": "chokidar 'public/images/**/*.{jpg,jpeg,png,gif,webp}' --ignore '**/*.temp' --ignore '**/*.backup' -c 'npm run upload:images' --silent"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.5",
    "@types/mdx": "^2.0.13",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "focus-trap-react": "^11.0.6",
    "next": "^15.5.10",
    "next-cloudinary": "^6.17.5",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-pretty-code": "^0.14.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "rss": "^1.2.2",
    "sharp": "^0.34.5",
    "shiki": "^3.21.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "sass": "^1.97.1",
    "typescript": "^5.9.0"
  }
}
