{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run watch:images\" \"next dev\"",
    "dev:fast": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "upload:images": "node scripts/upload-to-cloudinary.js",
    "watch:images": "chokidar 'public/images/**/*.{jpg,jpeg,png,gif,webp}' --ignore '**/*.temp' --ignore '**/*.backup' -c 'npm run upload:images' --silent"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@types/mdx": "^2.0.14",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "focus-trap-react": "^12.0.2",
    "next": "^15.5.19",
    "next-cloudinary": "^6.17.5",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-pretty-code": "^0.14.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.1",
    "shiki": "^4.2.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.6",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  }
}
